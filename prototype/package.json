{
  "name": "prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:pending": "node --experimental-transform-types --test tests/pending.test.mjs",
    "test:catalogue": "node --experimental-transform-types --test tests/item-catalog.test.mjs",
    "test:work-queue": "node --experimental-transform-types --test tests/work-queue.test.mjs",
    "test:autocomplete": "node --experimental-transform-types --test tests/autocomplete.test.mjs"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.1",
    "@microsoft/signalr": "^10.0.11",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "chart.js": "^4.6.1",
    "jsbarcode": "^3.12.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/jsbarcode": "^3.11.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.7",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
